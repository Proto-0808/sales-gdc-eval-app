# URL Web App hasil deploy Google Apps Script (lihat google-apps-script/Code.gs + README.md)
GOOGLE_SCRIPT_URL=https://script.google.com/macros/s/XXXXXXXXXXXXXXXX/exec

# Kode rahasia bebas (isi string apa saja), HARUS SAMA PERSIS dengan
# variabel SECRET di dalam Code.gs. Ini mencegah orang lain menulis/membaca
# data lewat URL Apps Script kalau URL-nya bocor.
GOOGLE_SCRIPT_SECRET=ganti-dengan-kode-rahasia-anda
